{
  "name": "aurelia-hall-school",
  "version": "0.1.0",
  "private": true,
  "description": "Sample build: public website + school CRM/ERP for a fictional British-curriculum girls' school.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --tsconfig tsconfig.seed.json prisma/seed.ts",
    "api:docs": "tsx --tsconfig tsconfig.seed.json scripts/build-openapi.ts",
    "db:snapshot": "node scripts/make-snapshot.mjs",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "images:fetch": "tsx scripts/fetch-images.ts",
    "credits": "tsx scripts/build-credits.ts",
    "verify-env": "tsx scripts/verify-env.ts",
    "postinstall": "node scripts/ensure-env.mjs && prisma generate",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx --tsconfig tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@node-rs/argon2": "^2.2.1",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
    "@prisma/client": "6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.49.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-hook-form": "^7.89.0",
    "reading-time": "^1.5.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
