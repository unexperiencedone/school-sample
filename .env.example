# ─────────────────────────────────────────────────────────────
# Aurelia Hall School — sample build. Every value below works
# out of the box for local demo use. Nothing here is a real key.
# ─────────────────────────────────────────────────────────────

# Core
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurelia?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"
# Used to sign sessions, captcha tokens and resume links. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-0000000000000000"
AUTH_TRUST_HOST="true"
CRON_SECRET="dev-cron-secret"

# Payments: mock | razorpay | payu | cashfree
PAYMENT_PROVIDER="mock"
MOCK_WEBHOOK_SECRET="dev-mock-webhook-secret"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_ENV="test"
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"

# Email: mock | smtp | ses | resend
EMAIL_PROVIDER="mock"
EMAIL_FROM="Aurelia Hall School <hello@aurelia-sample.test>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
RESEND_API_KEY=""

# WhatsApp: mock | gupshup | interakt | meta
WHATSAPP_PROVIDER="mock"
GUPSHUP_API_KEY=""
GUPSHUP_SOURCE_NUMBER=""
GUPSHUP_APP_NAME=""
INTERAKT_API_KEY=""
META_WA_TOKEN=""
META_WA_PHONE_NUMBER_ID=""

# SMS: mock | msg91 | twilio
SMS_PROVIDER="mock"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Lead/CRM webhook (optional). Leave empty to disable.
LEAD_WEBHOOK_URL=""
LEAD_WEBHOOK_SECRET="dev-lead-webhook-secret"

# Storage: local | s3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".storage"
S3_BUCKET=""
# (also uses AWS_REGION, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from the Email section above)
# Only for S3-compatible stores (Neon Object Storage, R2, MinIO); omit for AWS S3. S3_ENDPOINT also works.
AWS_ENDPOINT_URL_S3=""

# Captcha: image | turnstile | recaptcha | none
CAPTCHA_PROVIDER="image"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""

# Maps: static | google
MAPS_PROVIDER="static"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""

# Analytics (all off by default, and always gated by cookie consent)
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# Stock images (optional, used only by `pnpm images:fetch`)
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# ─────────────────────────────────────────────────────────────
# Vercel deploy (see docs/DEPLOY.md). Only these are needed:
#   DATABASE_URL (from the Neon integration), AUTH_SECRET, CRON_SECRET, NEXT_PUBLIC_DEMO_MODE=true
# Optional: DATABASE_URL_UNPOOLED (Neon sets it; used for migrations/seed), SEED_ON_BUILD=always (reseeds, WIPES data)
# ─────────────────────────────────────────────────────────────
